NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://creatorhub:changeme@localhost:5432/creatorhub

# JWT secrets — generate with: openssl rand -base64 48
# Must be at least 32 characters. Use DIFFERENT values for access and
# refresh secrets, and different values per environment.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_chars

# Razorpay — from the Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# From Razorpay Dashboard > Settings > Webhooks (separate from the API key secret)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudflare R2 (S3-compatible) — from the Cloudflare Dashboard > R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=creatorhub-files

# Must exactly match the frontend's deployed origin (protocol + host,
# no trailing slash) — used for CORS and cookie handling.
CLIENT_ORIGIN=http://localhost:5173
